# Example environment variables for running integration tests against a disposable Supabase project
# Copy this file to .env.test and fill in the values.

# Supabase project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=your-supabase-url

# Public anon key – used by the client for normal queries
SUPABASE_ANON_KEY=your-anon-key

# Service role key – required for admin actions in tests (user creation, role assignment)
# Keep this secret; do NOT commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
