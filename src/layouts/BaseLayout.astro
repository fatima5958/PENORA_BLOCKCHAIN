---
import '../styles/penora-brand.css';
import '../styles/global.css';
import { Header } from '../components/common/Header';
import { Footer } from '../components/common/Footer';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title = 'PENORA — Web3 Publishing & Reputation Protocol',
  description = 'A refined Web3 social publishing platform where creators publish longform essays, curate domain communities, and build verifiable reputation.',
  image = '/brand/penora-identity-board.jpg',
  type = 'website',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
// Configure PUBLIC_SITE_URL for production (e.g. https://your-domain.example).
// Social crawlers require absolute public URLs, not relative image paths.
const siteOrigin = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const socialImageUrl = new URL(image, siteOrigin).toString();
const privateRoute = /^\\/(?:login|signup|register|auth|settings|dashboard|wallet)(?:\\/|$)/.test(currentPath);
const shouldNoindex = noindex || privateRoute;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0A2540" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts for PENORA Blockchain Brand System: Sora (Display) + Inter (Body) + Michroma (Brand Eyebrow) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Michroma&family=Sora:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Social -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="PENORA" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="PENORA social preview" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageUrl} />

    <!-- Preconnect for image performance -->
    <link rel="preconnect" href="https://images.unsplash.com" />
  </head>
  <body class="pn-canvas min-h-screen flex flex-col antialiased">
    <!-- Header is its own React island — manages auth state independently via supabase.auth -->
    <Header client:load currentPath={currentPath} />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer client:idle />
  </body>
</html>
