---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LeftSidebar } from '../components/layout/LeftSidebar';
import { RightSidebar } from '../components/layout/RightSidebar';
import { MOCK_COMMUNITIES, MOCK_TOPICS } from '../data/mockArticles';
import { Bell, Heart, MessageSquare, UserPlus, Award } from 'lucide-react';

const mockNotifications = [
  {
    id: 1,
    type: 'vote',
    icon: Heart,
    color: 'text-[#007C8B]',
    title: 'Elena Rostova (94) upvoted your story',
    target: 'How to Be An SQA Engineer: Series Part 1',
    time: '25 minutes ago',
    repGain: '+15 Rep',
  },
  {
    id: 2,
    type: 'comment',
    icon: MessageSquare,
    color: 'text-[#0A2540]',
    title: 'Marcus Chen (88) left a perspective on your essay',
    target: 'The Architecture of Spatial Interfaces',
    time: '2 hours ago',
    repGain: '+5 Rep',
  },
  {
    id: 3,
    type: 'follow',
    icon: UserPlus,
    color: 'text-[#007C8B]',
    title: 'Seraphina Ross (91) followed your publications',
    target: '@mateenfatima',
    time: 'Yesterday',
    repGain: '+10 Rep',
  },
  {
    id: 4,
    type: 'award',
    icon: Award,
    color: 'text-[#007C8B]',
    title: 'Promoted to Senior Contributor Tier (68 Rep)',
    target: 'Curation Protocol Consensus',
    time: '3 days ago',
    repGain: 'Badge Earned',
  },
];
---

<BaseLayout
  title="Notifications — PENORA Blockchain Publishing"
  description="Stay updated with peer upvotes, commentary, citations, and community curation alerts."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      {/* Left Sidebar */}
      <div class="hidden lg:block lg:col-span-3 sticky top-20">
        <LeftSidebar
          client:load
          currentTab="notifications"
          communities={MOCK_COMMUNITIES}
          isLoggedIn={true}
        />
      </div>

      {/* Main Column */}
      <main class="lg:col-span-6 space-y-4">
        <div class="pn-panel p-4 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <Bell className="h-5 w-5 text-[#007C8B]" />
            <h1 class="font-display text-lg font-bold text-[#0A2540]">
              Activity & Notifications
            </h1>
          </div>
          <span class="pn-tag">
            All Caught Up
          </span>
        </div>

        <div class="space-y-3">
          {mockNotifications.map((n) => {
            const Icon = n.icon;
            return (
              <div
                class="pn-card pn-card-interactive p-4 flex items-start justify-between gap-3"
              >
                <div class="flex items-start gap-3">
                  <div class={`h-9 w-9 rounded-xl bg-[#00E5F4]/12 border border-[#007C8B]/15 flex items-center justify-center ${n.color} flex-shrink-0 mt-0.5`}>
                    <Icon className="h-4 w-4" />
                  </div>
                  <div>
                    <p class="text-xs font-semibold text-[#0A2540] leading-snug">
                      {n.title}
                    </p>
                    <p class="text-xs text-[#007C8B] font-medium mt-0.5">
                      "{n.target}"
                    </p>
                    <span class="text-[10px] text-[#7B8FA6] mt-1 block">
                      {n.time}
                    </span>
                  </div>
                </div>

                <span class="pn-tag font-mono">
                  {n.repGain}
                </span>
              </div>
            );
          })}
        </div>
      </main>

      {/* Right Sidebar */}
      <div class="hidden lg:block lg:col-span-3 sticky top-20">
        <RightSidebar client:load topics={MOCK_TOPICS} />
      </div>

    </div>
  </div>
</BaseLayout>
