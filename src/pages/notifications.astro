---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LeftSidebar } from '../components/layout/LeftSidebar';
import { RightSidebar } from '../components/layout/RightSidebar';
import { MOCK_COMMUNITIES, MOCK_TOPICS } from '../data/mockArticles';
import { Bell, ArrowRight } from 'lucide-react';
---

<BaseLayout
  title="Notifications — PENORA Blockchain Publishing"
  description="Stay updated with peer upvotes, commentary, citations, and community curation alerts."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      {/* Left Sidebar */}
      <div class="hidden lg:block lg:col-span-3 sticky top-20">
        <LeftSidebar
          client:load
          currentTab="notifications"
          communities={MOCK_COMMUNITIES}
          isLoggedIn={true}
        />
      </div>

      {/* Main Column */}
      <main class="lg:col-span-6 space-y-4">
        <div class="pn-panel p-4 flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <Bell className="h-5 w-5 text-[#007C8B]" />
            <h1 class="font-display text-lg font-bold text-[#0A2540]">
              Activity & Notifications
            </h1>
          </div>
          <span class="pn-tag">
            All Caught Up
          </span>
        </div>

        <div class="pn-card p-10 text-center space-y-3">
          <div class="h-12 w-12 rounded-2xl bg-[#00E5F4]/15 text-[#007C8B] flex items-center justify-center mx-auto border border-[#007C8B]/20">
            <Bell className="h-6 w-6" />
          </div>
          <h2 class="pn-h2">No new notifications</h2>
          <p class="text-xs sm:text-sm text-[#4A5B70] max-w-sm mx-auto leading-relaxed">
            When peer creators upvote your blogs, leave perspectives, or follow your publications, your real-time notifications will appear here.
          </p>
          <div class="pt-2 flex items-center justify-center gap-3 flex-wrap">
            <a href="/" class="pn-btn pn-btn-secondary pn-btn-sm">
              <span>Explore Home Feed</span>
            </a>
            <a href="/editor" class="pn-btn pn-btn-brand pn-btn-sm">
              <span>Publish a Blog</span>
              <ArrowRight className="h-3 w-3" />
            </a>
          </div>
        </div>
      </main>

      {/* Right Sidebar */}
      <div class="hidden lg:block lg:col-span-3 sticky top-20">
        <RightSidebar client:load topics={MOCK_TOPICS} />
      </div>
    </div>
  </div>
</BaseLayout>
